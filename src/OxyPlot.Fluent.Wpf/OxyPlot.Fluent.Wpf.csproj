<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
    <PropertyGroup>
        <TargetFrameworks>net10.0-windows;net462</TargetFrameworks>
        <UseWpf>true</UseWpf>

        <PackageTags>$(CommonPackageTags);WPF</PackageTags>

        <Description>
            $(CommonDescription)
            This library contains the functionality for creating views and view models in WPF.
        </Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="OxyPlot.Wpf" Version="$(OxyPlotVersion)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OxyPlot.Fluent\OxyPlot.Fluent.csproj" />
    </ItemGroup>
</Project>
